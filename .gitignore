vendor/

.config/*
!.config/gh/
# gh writes auth tokens into hosts.yml when the OS keyring is unavailable; never
# track it in this public repo. Only config.yml (no secrets) is versioned.
.config/gh/hosts.yml
!.config/git/
!.config/latex/
!.config/claude/
!.config/zed/
!.config/herdr/
!.config/herdr-app/

# Override global gitignore to track CLAUDE.md in this repo
!CLAUDE.md
!.config/claude/CLAUDE.md
# Herdr rewrites these into every mod folder on start
.config/herdr-app/mods/*/gpui-kit.d.ts
.config/herdr-app/mods/*/jsconfig.json
